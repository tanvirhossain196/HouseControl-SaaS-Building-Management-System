# Copy to .env.local and fill in. Never commit .env.local.

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated origins allowed to call /api. Defaults to NEXT_PUBLIC_SITE_URL.
ALLOWED_ORIGINS=http://localhost:3000
# Requests per minute per IP on /api (auth, payments and uploads are stricter).
RATE_LIMIT_PER_MINUTE=60

# ---- Supabase ----
# Project settings → API. The anon key is public; the service role key is not.
#
# Leave these commented out to run the public site without a database: the
# landing page, the style guide and the auth screens all render. Uncomment and
# fill them in when you have a project, and everything behind sign-in works.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Project settings → Database → connection string. Used by psql and db:types.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
SUPABASE_PROJECT_ID=

# ---- Auth (Phase 3) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Handover codes (Phase 8) ----
# Salts the hash of moderator-handover codes. Falls back to the service role
# key when unset; set it separately in production.
OTP_SECRET=

# ---- Email (Phase 11) ----
RESEND_API_KEY=
EMAIL_FROM="HouseControl <no-reply@example.com>"

# ---- Notifications (Phase 11) ----
# Unset: email and SMS are written to the delivery log instead of being sent,
# which keeps a deployment without provider contracts fully working.
SMS_PROVIDER_KEY=
SMS_SENDER_ID=HouseControl
# Shared secret for GET /api/cron/reminders. Required for the daily job.
CRON_SECRET=

# ---- Payments (Phase 7) ----
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
# Merchant panel → IPN settings:
#   https://yourdomain.com/api/payments/webhook/sslcommerz

# ---- Monitoring (Phase 15) ----
SENTRY_DSN=
