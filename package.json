{
  "name": "housecontrol",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "for f in supabase/migrations/*.sql; do psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f \"$f\"; done",
    "db:seed": "psql \"$DATABASE_URL\" -f supabase/seed.sql",
    "db:types": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" --schema public > src/types/database.ts",
    "test:permissions": "tsx tests/permissions.test.ts",
    "test:units": "tsx tests/units.test.ts",
    "test": "npm run test:permissions && npm run test:units && npm run test:rent && npm run test:rent-flow && npm run test:billing && npm run test:gateway && npm run test:otp && npm run test:gate && npm run test:maintenance && npm run test:notifications",
    "test:rent": "tsx tests/rent-split.test.ts",
    "test:rent-flow": "tsx tests/rent-flow.test.ts",
    "test:billing": "tsx tests/billing.test.ts",
    "test:gateway": "tsx tests/gateway.test.ts",
    "test:otp": "tsx tests/otp.test.ts",
    "test:gate": "tsx tests/gate.test.ts",
    "test:maintenance": "tsx tests/maintenance.test.ts",
    "test:notifications": "tsx tests/notifications.test.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.427.0",
    "next": "^14.2.35",
    "next-themes": "^0.3.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.41",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "tailwindcss": "^3.4.10",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.13",
    "typescript": "^5.5.4"
  }
}
